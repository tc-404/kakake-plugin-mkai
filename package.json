{
  "name": "kakake-plugin-mkai",
  "plugin": "MK_AI",
  "version": "1.4.0",
  "type": "module",
  "main": "index.mjs",
  "webuiModule": "webui/remote.js",
  "description": "智能对话 - 独立 AI 聊天插件（Kakake React 后台）",
  "author": "三个句号",
  "license": "MIT",
  "keywords": [
    "kakake",
    "plugin",
    "smart-chat",
    "ai"
  ],
  "dependencies": {
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@types/node": "^20.19.33",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.5.0",
    "esbuild": "0.25.12",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "scripts": {
    "build": "npm run typecheck:node && node scripts/build-webui.mjs && vite build",
    "build:webui": "node scripts/build-webui.mjs",
    "pack": "node scripts/pack-plugin.mjs",
    "pack:fast": "node scripts/pack-plugin.mjs --skip-verify",
    "pack:only": "node scripts/pack-plugin.mjs --no-build --skip-verify",
    "watch": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "test": "npm run verify:all",
    "verify:all": "node scripts/run-all-verifies.mjs",
    "verify:list": "node scripts/run-all-verifies.mjs --list",
    "quality:baseline": "node scripts/quality-baseline.mjs",
    "quality:gate": "node scripts/quality-baseline.mjs --gate",
    "verify:failure-recovery": "node scripts/verify-failure-recovery.mjs",
    "verify:context-budget": "node scripts/verify-context-budget.mjs",
    "verify:bounded-output": "node scripts/verify-bounded-output.mjs",
    "verify:media-path": "node scripts/verify-media-path.mjs",
    "verify:voice-display": "node scripts/verify-voice-display.mjs",
    "verify:pack": "node scripts/verify-pack.mjs",
    "verify:force-speak-log": "node scripts/verify-force-speak-log.mjs",
    "verify:scene": "node scripts/verify-silence-scene.mjs",
    "verify:transcript": "node scripts/verify-session-transcript.mjs",
    "verify:model-protocol": "node scripts/verify-model-protocol.mjs",
    "verify:persona-fusion": "node scripts/verify-persona-fusion.mjs",
    "verify:prefix-cache": "node scripts/verify-prefix-cache.mjs",
    "verify:staleness": "node scripts/verify-batch-staleness.mjs",
    "verify:random-wait": "node scripts/verify-random-wait.mjs",
    "verify:panel": "node scripts/verify-panel-layering.mjs",
    "verify:style": "node scripts/verify-style-diversity.mjs",
    "verify:silence-policy": "node scripts/verify-silence-policy.mjs",
    "verify:system-prompt": "node scripts/verify-system-prompt.mjs",
    "verify:v10": "node scripts/verify-v10-gates.mjs",
    "verify:compact": "node scripts/verify-compact-policy.mjs",
    "verify:persona": "node scripts/verify-persona-clamp.mjs",
    "verify:presence": "node scripts/verify-presence-knowledge.mjs",
    "verify:nvidia": "node scripts/verify-nvidia-overflow.mjs",
    "verify:smart-chat": "npm run verify:scene && npm run verify:v10 && npm run verify:compact && npm run verify:persona && npm run verify:transcript && npm run verify:model-protocol && npm run verify:persona-fusion && npm run verify:presence && npm run verify:nvidia && npm run verify:prefix-cache && npm run verify:staleness && npm run verify:random-wait && npm run verify:panel && npm run verify:style && npm run verify:silence-policy && npm run verify:system-prompt && npm run verify:failure-recovery && npm run verify:context-budget && npm run verify:bounded-output && npm run verify:media-path && npm run verify:voice-display && npm run verify:voice-default-role && npm run verify:overview-perf && npm run verify:overview-e2e && npm run verify:sticker-source && npm run verify:pack",
    "verify:overview-perf": "node scripts/verify-overview-perf.mjs",
    "verify:overview-e2e": "node scripts/verify-overview-e2e.mjs",
    "verify:voice-default-role": "node scripts/verify-voice-default-role.mjs",
    "verify:sticker-source": "node scripts/verify-sticker-source.mjs"
  }
}
